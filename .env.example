# Cerquita — variables de entorno
#
# Copiá este archivo a `.env` y completá lo que necesites:
#
#   cp .env.example apps/api/.env
#
# La API es la única que lo lee: la web y la consola sólo necesitan
# NEXT_PUBLIC_API_URL, que ya tiene un default correcto en desarrollo.
#
# NUNCA commitees un `.env` con valores reales.
#
# Cerquita arranca sin ninguna credencial de terceros: todos los providers
# externos tienen un mock funcional. Sólo hace falta la base de datos.

# ── Entorno ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api
LOG_LEVEL=info

# Orígenes permitidos por CORS, separados por coma.
# 3000 es la web, 3001 la consola de administración.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Base de datos ─────────────────────────────────────────────────────────────
# Requiere PostgreSQL con PostGIS. `docker compose up -d` levanta la imagen
# correcta (postgis/postgis:16-3.4).
DATABASE_URL=postgresql://cerquita:cerquita@localhost:5432/cerquita?schema=public

# ── Redis ─────────────────────────────────────────────────────────────────────
# Usado para cache y colas de trabajos en segundo plano.
REDIS_URL=redis://localhost:6379

# ── Autenticación ─────────────────────────────────────────────────────────────
# OBLIGATORIO. Mínimo 32 caracteres, sin valor por defecto: la app no arranca
# sin esto, a propósito. Generá uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Duración del access token (formato: 15m, 2h, 7d).
JWT_ACCESS_TTL=15m
# Duración del refresh token, en días.
JWT_REFRESH_TTL_DAYS=30

# ── Providers externos ────────────────────────────────────────────────────────
# Todos aceptan un mock. En producción (NODE_ENV=production) la app se niega a
# arrancar con providers mock de pagos o storage.

# mock | mercadopago | stripe
PAYMENT_PROVIDER=mock
# mock | anthropic
AI_PROVIDER=mock
# local | s3
STORAGE_PROVIDER=local
# mock | expo
PUSH_PROVIDER=mock
# console | noop
ANALYTICS_PROVIDER=console

# ── Credenciales de providers ─────────────────────────────────────────────────
# Sólo necesarias si cambiás el provider correspondiente. La validación de
# arranque falla si elegís un provider real sin su credencial.

# Mercado Pago (integración prioritaria para Argentina).
# Obtener en: https://www.mercadopago.com.ar/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=

# Stripe (declarado pero no implementado todavía).
STRIPE_SECRET_KEY=

# API de Anthropic, para búsqueda en lenguaje natural y asistente de publicación.
# Sin esto, el provider mock hace un parseo por reglas que funciona en castellano.
ANTHROPIC_API_KEY=

# ── Storage ───────────────────────────────────────────────────────────────────
# Con STORAGE_PROVIDER=local los archivos van a disco.
LOCAL_STORAGE_DIR=.storage
PUBLIC_ASSET_BASE_URL=http://localhost:4000/assets

# Con STORAGE_PROVIDER=s3 (compatible con S3, MinIO, R2…).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ── Clientes web ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Plantilla de tiles del mapa. OPCIONAL: sin esto el mapa funciona igual, con
# una grilla de referencia en lugar de cartografía.
# Ejemplo: https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Revisá siempre los términos de uso del proveedor de tiles.
NEXT_PUBLIC_MAP_TILE_URL=
