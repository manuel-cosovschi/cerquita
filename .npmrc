enable-pre-post-scripts=true
auto-install-peers=true
strict-peer-dependencies=false

# React Native's bundler resolves modules by walking node_modules directories,
# not by following the package graph, so a package Expo requires transitively
# has to actually exist somewhere Metro looks. pnpm's isolated layout hides
# those, which is why Expo's own docs call for hoisting them.
#
# This hoists ONLY the React Native toolchain to the workspace root rather than
# switching the whole repo to a hoisted linker: the API and the web apps resolve
# correctly under isolation and benefit from keeping it.
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=@react-navigation/*
public-hoist-pattern[]=*metro*
